# Every key below is optional. With none set, VeriResearch runs entirely offline:
# a deterministic planner, the bundled local research corpus (nodes/local_corpus.py)
# or an honest "no search backend" placeholder, and the offline heuristic judge.
# `python scripts/demo_verifier.py` and `pytest` never need any of these.

# Grok-as-judge (verifier), LLM-drafted planner/writer. Without this, the
# planner is template-based, the writer copies verbatim from sources, and the
# verifier uses the offline heuristic judge.
GROK_API_KEY=

# Live web search for the researcher node. Without this, research falls back
# to the bundled local corpus (a handful of demo topics) or an explicit
# no-content placeholder for anything outside it.
TAVILY_API_KEY=

# Optional: NLI cross-encoder judge backend (VERIFIER_BACKEND=nli). Requires
# `pip install -e ".[nli]"` — not needed for heuristic or llm backends.
# (no key required, just the local model download on first use)

# Optional: Langfuse tracing (cost/latency/token count per node).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Tuning (all have sane defaults — see src/veriresearch/config.py) ---
# VERIFIER_BACKEND=auto            # auto | heuristic | llm | nli | cascade
# VERIFIER_SUPPORT_THRESHOLD=0.70
# VERIFIER_PARTIAL_THRESHOLD=0.40
# VERIFIER_CONTRADICTION_THRESHOLD=0.55
# VERIFIER_UNGROUNDED_PENALTY=0.35
# VERIFIER_LLM_MODEL=grok-4
# GRAPH_MAX_REVISIONS=2

# --- API deployment (see DEPLOY.md) ---
# Without DATABASE_URL, runs are stored in memory (dev/tests) and vanish on
# restart. Set it to a Postgres URL (e.g. Railway's Postgres plugin provides
# one automatically) to persist runs and allow the API to run as more than
# one process. Requires `pip install -e ".[db]"`.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Comma-separated list of origins allowed to call this API (CORS). Defaults
# to the local Vite dev server if unset — set this to your deployed
# frontend's URL in production.
# CORS_ORIGINS=https://your-frontend.up.railway.app

# Cap on runs that may be queued/running at once before POST /runs returns
# 429. This API has no auth, so this is the resource-exhaustion backstop for
# a public deploy.
# MAX_CONCURRENT_RUNS=5
